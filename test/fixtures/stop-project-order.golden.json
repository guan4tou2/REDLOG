 "openFresh": {
  "linux": [
   "getProjectPath({id})",
   "prepareOpenConfig(\"PROJECT_DIR\")",
   "projectRuntime.current()",
   "projectRuntime.begin({id}, {engagementId,operatorId})",
   "initDB(\"PROJECT_DIR\")",
   "restrictProjectDirs(\"PROJECT_DIR\")",
   "bindDBEngagement(\"default\")",
   "openHudPrefs(undefined)",
   "configApplier.apply({reason,identity,next,hooks})",
   "  apply.step wifiName",
   "  apply.step screenshot",
   "  apply.hook resetProjectCaches {",
   "invalidateObservationCount()",
   "resetVisibilitySignalsCache()",
   "  } resetProjectCaches",
   "  apply.step alertRuntime",
   "  apply.step lootDetector",
   "  apply.step captureHealth",
   "  apply.step redaction",
   "  apply.hook loadPlugins {",
   "setTailerContributionSink(ƒ, ƒ)",
   "initPlugins()",
   "  } loadPlugins",
   "  apply.step vpnAdapters",
   "  apply.step terminal",
   "  apply.hook wireTerminalIngest {",
   "configureTerminalProxy(ƒ)",
   "setCastProbe(<getCastPosition>)",
   "  } wireTerminalIngest",
   "  apply.step ingestActiveTarget",
   "  apply.hook startProjectServices {",
   "sweepRetention({engagement,operator,network,scope,screenshot,terminal,browser,httpCapture,redaction,fileWatcher,processMonitor,connectionMonitor,packs,agentTailer,loot,retention}, <projectRuntime.begin()>)",
   "sweepBookmarks({keepDays}, <projectRuntime.begin()>)",
   "sweepBodyStore({engagement,operator,network,scope,screenshot,terminal,browser,httpCapture,redaction,fileWatcher,processMonitor,connectionMonitor,packs,agentTailer,loot,retention}, <projectRuntime.begin()>)",
   "sweepArtifactStore(\"cast\", {engagement,operator,network,scope,screenshot,terminal,browser,httpCapture,redaction,fileWatcher,processMonitor,connectionMonitor,packs,agentTailer,loot,retention}, <projectRuntime.begin()>)",
   "sweepArtifactStore(\"screenshot\", {engagement,operator,network,scope,screenshot,terminal,browser,httpCapture,redaction,fileWatcher,processMonitor,connectionMonitor,packs,agentTailer,loot,retention}, <projectRuntime.begin()>)",
   "sweepLoggedTier({keepDays,sweepIntervalHours}, <projectRuntime.begin()>)",
   "projectRuntime.setInterval(<projectRuntime.begin()>, ƒ, 86400000)",
   "recoverOrphanSessions()",
   "resumeTerminalRecordings()",
   "discoverShells()",
   "discoverShells().catch(ƒ)",
   "startSpoolDrain({drainOnce,finish,total,slice,isCurrent,repeat})",
   "alertRuntime.start()",
   "startLinkMonitor()",
   "configureOpsecMonitor(ƒ)",
   "startOpsecMonitor()",
   "  } startProjectServices",
   "  apply.step fileWatcherOptions",
   "  apply.step connectionMonitorOptions",
   "  apply.step powershellTranscriptIdentity",
   "  apply.step processMonitorOptions",
   "  apply.step agentTailerHost",
   "  apply.step packFileWatcher",
   "  apply.step packConnectionMonitor",
   "  apply.step packProcessMonitor",
   "  apply.step packPowershellTranscript",
   "  apply.step agentTailer",
   "configureApi({engagementId,operatorId,operatorName,testHooks,configLoader,lootDetector,screenshotAgent,bundleExporter,alertRuntime,sessionRegistry,httpVerifySink})",
   "onApiProjectOpen()",
   "recordProjectOpen({sessionStart,write,paused,onError,schedule,isCurrent})",
   "setUpdaterAirgap(false)",
   "insertEvent(\"system\", {subtype,enabled,description}, <projectRuntime.begin()>)",
   "startAnchorLoop()",
   "startNtpLoop()",
   "app.getPath(\"userData\")",
   "readUpdateMarker(<app.getPath()>)",
   "getProjectDir()",
   "clearSampleBroken()",
   "verifyRandomSample(100)",
   "projectRuntime.setInterval(<projectRuntime.begin()>, ƒ, 300000)",
   "loadOverlayPosition()",
   "createOverlayWindow(<loadOverlayPosition()>, {show})",
   "bindOverlayReleaseShortcut(<createOverlayWindow().webContents>)",
   "createOverlayWindow().on(\"show\", <syncReleaseShortcut>)",
   "createOverlayWindow().on(\"hide\", <syncReleaseShortcut>)",
   "createOverlayWindow().on(\"closed\", <syncReleaseShortcut>)",
   "createOverlayWindow().on(\"moved\", ƒ)",
   "applyHudPrefs()",
   "setTrayRecording(<tray>, false)",
   "loginPathReady.then(ƒ)",
   "loginPathReady.then().catch(ƒ)",
   "backfillCastIndex(\"PROJECT_DIR\", undefined, <projectRuntime.begin().signal>)",
   "backfillCastIndex().catch(ƒ)",
   "writeSpoolIdentity(<projectRuntime.begin()>)",
   "projectRuntime.activate(<projectRuntime.begin()>)"
  ],
