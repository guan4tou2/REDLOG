      "canonical": "{\"outer\":{\"list\":[{\"😀\":1,\"～\":2}],\"\":{\"𐀀\":\"x\",\"￿\":\"y\"}},\"􏿿\":true,\"�\":false}",
      "sha256": "429f80e664bf00697333c6d79f9c8bda2b6d5dd357c927696d1f75c8bb291df9"
    },
    {
      "name": "BMP keys: case, digits, integer-like keys, punctuation",
