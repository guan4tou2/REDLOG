      "canonical": "{\"\":10,\" \":11,\"-1\":9,\"01\":8,\"10\":6,\"9\":7,\"B\":2,\"a-b\":4,\"a_b\":3,\"ab\":5,\"b\":1,\"é\":13,\"é\":12}",
      "sha256": "8fdeafe66e550f8680cd9cb9671f55424a14709966d88f0ac6ee60a6a88fd11b"
    },
    {
