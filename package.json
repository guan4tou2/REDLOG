{
  "name": "redlog",
  "version": "0.18.0",
  "description": "Red Team Operation Log",
  "author": "guan4tou2",
  "repository": {
    "type": "git",
    "url": "https://github.com/guan4tou2/REDLOG.git"
  },
  "homepage": "https://github.com/guan4tou2/REDLOG",
  "bugs": "https://github.com/guan4tou2/REDLOG/issues",
  "license": "MIT",
  "main": "./out/main/index.js",
  "bin": {
    "redlog-cli": "./cli/redlog-cli.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "verify:package-resources": "node scripts/verify-packaged-resources.mjs",
    "verify:specs": "node scripts/verify-specs.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "pree2e": "electron-rebuild -f -o better-sqlite3",
    "e2e": "playwright test",
    "pree2e:ui": "electron-rebuild -f -o better-sqlite3",
    "e2e:ui": "playwright test --ui",
    "gen:settings-search": "node scripts/gen-settings-search.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.33.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.49",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
