{
  "name": "redlog",
  "version": "0.18.6",
  "description": "Red Team Operation Log",
  "author": "guan4tou2",
  "repository": {
    "type": "git",
    "url": "https://github.com/guan4tou2/REDLOG.git"
  },
  "homepage": "https://github.com/guan4tou2/REDLOG",
  "bugs": "https://github.com/guan4tou2/REDLOG/issues",
  "license": "MIT",
  "main": "./out/main/index.js",
  "bin": {
    "redlog-cli": "./cli/redlog-cli.js"
  },
  "scripts": {
    "dev": "npm run build:ai-plugins && electron-vite dev",
    "build": "npm run build:ai-plugins && electron-vite build && npm run build:export-worker",
    "verify:package-resources": "node scripts/verify-packaged-resources.mjs",
    "verify:package-resources:smoke": "node scripts/verify-packaged-resources.mjs --smoke",
    "verify:specs": "node scripts/verify-specs.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f",
    "pretest": "npm rebuild better-sqlite3 && npm run build:ai-plugins && npm run build:export-worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "npm test -- --changed=origin/main",
    "pree2e": "electron-rebuild -f -o better-sqlite3",
    "e2e": "playwright test",
    "e2e:core": "npm run e2e -- e2e/export-preview.spec.ts e2e/evidence-views.spec.ts e2e/network-state-recovery.spec.ts",
    "e2e:smoke": "node scripts/run-installed-smoke.mjs",
    "pree2e:ui": "electron-rebuild -f -o better-sqlite3",
    "e2e:ui": "playwright test --ui",
    "gen:settings-search": "node scripts/gen-settings-search.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:i18n": "node scripts/verify-i18n-assertions.mjs",
    "build:export-worker": "node scripts/build-export-worker.mjs",
    "build:ai-plugins": "node scripts/build-ai-plugins.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.11",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.70.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
