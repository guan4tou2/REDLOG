{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./out",
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/core/**/*", "src/renderer/src/**/*", "src/renderer/src/**/*.json"]
}
